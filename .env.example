# ============================================
# YEO - Environment Variables
# ============================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Google OAuth: add redirect URL in Supabase Auth → URL configuration, e.g.
# https://yeonote.vercel.app/auth/callback (production) and http://localhost:3000/auth/callback (dev)

# --- OpenAI ---
OPENAI_API_KEY=your_openai_api_key

# --- Lemon Squeezy ---
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_api_key
# Numeric store id (API / dashboard reference). Not used as checkout subdomain.
LEMONSQUEEZY_STORE_ID=your_numeric_store_id
# Optional: store subdomain (dashboard only). Checkout URLs come from POST /v1/checkouts API.
LEMONSQUEEZY_STORE_SLUG=your-store-slug
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_secret
LEMONSQUEEZY_PRODUCT_ID=your_catalog_product_id
# Checkout variant ids (Pricing → Buy Now). One-time vs subscription use different variants.
NEXT_PUBLIC_LS_VARIANT_STARTER=your_one_time_starter_variant_id
NEXT_PUBLIC_LS_VARIANT_GROWTH=your_one_time_growth_variant_id
NEXT_PUBLIC_LS_VARIANT_BULK=your_one_time_bulk_variant_id
NEXT_PUBLIC_LS_VARIANT_SUB_STARTER=your_subscription_starter_variant_id
NEXT_PUBLIC_LS_VARIANT_SUB_GROWTH=your_subscription_growth_variant_id
NEXT_PUBLIC_LS_VARIANT_SUB_BULK=your_subscription_bulk_variant_id
# Legacy one-time Pro / Team (optional; webhook still grants credits if these ids appear on old orders)
LEMONSQUEEZY_VARIANT_ID_PRO=
LEMONSQUEEZY_VARIANT_ID_TEAM=
# Optional: pre-built customer billing portal URL
LEMONSQUEEZY_BILLING_PORTAL_URL=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=YEO

# --- Analytics (Optional) ---
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# --- Rate Limiting (optional; AI routes skip limiter if unset) ---
UPSTASH_REDIS_REST_URL=your_upstash_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# --- Email (Optional, for notifications) ---
RESEND_API_KEY=your_resend_api_key
