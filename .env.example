# ============================================
# YEO - Environment Variables
# ============================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Google OAuth: add redirect URL in Supabase Auth → URL configuration, e.g.
# https://yeonote.vercel.app/auth/callback (production) and http://localhost:3000/auth/callback (dev)

# --- OpenAI ---
OPENAI_API_KEY=your_openai_api_key

# --- Lemon Squeezy (subscription billing) ---
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_api_key
LEMONSQUEEZY_STORE_ID=your_numeric_store_id
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_secret
LEMONSQUEEZY_PRODUCT_ID=your_catalog_product_id

# Plus Plan
LEMONSQUEEZY_PLUS_MONTHLY_VARIANT_ID=your_plus_monthly_variant_id
LEMONSQUEEZY_PLUS_YEARLY_VARIANT_ID=your_plus_yearly_variant_id

# Pro Plan
LEMONSQUEEZY_PRO_MONTHLY_VARIANT_ID=your_pro_monthly_variant_id
LEMONSQUEEZY_PRO_YEARLY_VARIANT_ID=your_pro_yearly_variant_id

# Optional: pre-built customer billing portal URL
LEMONSQUEEZY_BILLING_PORTAL_URL=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=YEO

# --- Analytics (Optional) ---
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# --- Rate Limiting (optional; AI routes skip limiter if unset) ---
UPSTASH_REDIS_REST_URL=your_upstash_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# --- Email (Optional, for notifications) ---
RESEND_API_KEY=your_resend_api_key
